{
  "name": "dsh-strata-ai-center",
  "version": "2.5.1",
  "description": "AI管理中心 (Strata Engine Manager) — 在 DeepSeek Harness (DSH) 左侧栏「记忆系统」下方管理本机 Strata 引擎：经 strata launch 启停模型、编辑 strata-<model>.json 运行配置、组件升级与回滚，并从 /health /v1/status /v1/telemetry /metrics 读取真实监控数据。安装路径自动探测，开箱即用。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "install-plugin.ps1"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "strata",
    "ai-center",
    "model-manager",
    "monitor"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newgacker/dsh-strata-ai-center.git"
  },
  "homepage": "https://github.com/newgacker/dsh-strata-ai-center#readme",
  "bugs": {
    "url": "https://github.com/newgacker/dsh-strata-ai-center/issues"
  }
}
